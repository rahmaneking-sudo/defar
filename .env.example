# ─────────────────────────────────────────────────────────────────────────────
# Défar — variables d'environnement
# Copie ce fichier en « .env.local » pour le développement, et ajoute les mêmes
# variables dans Vercel : Projet → Settings → Environment Variables (puis redéploie).
# Aucune de ces clés n'est jamais envoyée au navigateur.
# Tout est facultatif : sans clé, le site fonctionne en mode démo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Comptes, crédits, sites publiés (Supabase) ──
# Supabase → Project Settings → API (ou « API Keys ») : « Project URL » et la clé publique
# (« anon public » ou « publishable »). Ces deux valeurs peuvent être visibles dans le navigateur :
# ce sont les règles de supabase/schema.sql qui protègent les données.
# Sans elles, le site marche comme avant (maquettes enregistrées sur l'appareil, sans comptes).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# (facultatif) nom de domaine pour les sites des clients : salon-awa.defar.sn au lieu de defar.sn/s/salon-awa
# Nécessite un domaine « joker » *.defar.sn configuré dans Vercel.
VITE_SITES_DOMAIN=

# ── Intelligence artificielle (au moins une clé pour des maquettes sur mesure) ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (tout service compatible OpenAI)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# AI_PROVIDER=anthropic      (fournisseur essayé en premier : anthropic | openai | gemini)

# ── Photos et vidéos sur mesure (sinon : bibliothèque intégrée) ──
PEXELS_API_KEY=

# ── Protection du studio ──
# Sans Supabase : code demandé avant de générer avec l'IA (protège tes crédits). Vide = libre.
# Avec Supabase, ce code n'est plus utilisé : il faut un compte et des crédits.
ACCESS_CODE=
# Générations IA maximum par heure et par visiteur
RATE_LIMIT_PER_HOUR=30
# Domaines autorisés à appeler l'API depuis un autre site (séparés par des virgules)
ALLOWED_ORIGINS=
# Adresse publique du site (utile avec un nom de domaine : https://www.monsite.sn)
PUBLIC_URL=

# ── Paiements : Wave (API Checkout directe) ──
WAVE_API_KEY=
# Seulement si tu as activé la signature des requêtes sur ta clé Wave
WAVE_SIGNING_SECRET=
# Secret du webhook déclaré dans le portail Wave Business (…/api/pay/webhook-wave)
WAVE_WEBHOOK_SECRET=

# ── Paiements : PayDunya (Orange Money, Mixx by Yas, Wave, carte) ──
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test (bac à sable) puis live une fois ton compte validé
PAYDUNYA_MODE=test

# ── Ton commerce ──
# Nom affiché sur le checkout et les reçus
MERCHANT_NAME=Défar
# Mot de passe de la page /paiements : crée des liens signés (montant infalsifiable)
ADMIN_PASSWORD=
# (facultatif) secret dédié à la signature des liens ; sinon dérivé d'ADMIN_PASSWORD
PAY_LINK_SECRET=
# Reçoit chaque paiement confirmé (Make, Zapier, Google Apps Script → Google Sheets…)
ORDER_WEBHOOK_URL=
